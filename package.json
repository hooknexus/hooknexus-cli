{
  "name": "hooknexus",
  "version": "1.0.2",
  "description": "Official CLI for HookNexus - Real-time Webhook Debugging Platform",
  "keywords": [
    "webhook",
    "debug",
    "cli",
    "tunnel",
    "hooknexus",
    "localhost",
    "forward"
  ],
  "author": "HookNexus <cloud@hooknexus.com>",
  "license": "MIT",
  "homepage": "https://hooknexus.com",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hooknexus/hooknexus-cli.git"
  },
  "bin": {
    "hooknexus": "bin/hooknexus.js",
    "hnx": "bin/hooknexus.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "start": "node bin/hooknexus.js",
    "lint": "tsc --noEmit",
    "test": "pnpm run test:commands",
    "test:commands": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "conf": "^13.0.1",
    "inquirer": "^9.3.7",
    "open": "^10.1.0",
    "ora": "^8.1.1",
    "undici": "^6.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.3.0",
    "vitest": "^2.1.8"
  }
}
